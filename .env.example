# Copy this file to .env and fill in your own values.
# Do not commit the real .env file.

# Path to the root folder that holds the image dataset
# (the folder with the train/val/test split inside).
DATA_DIR=data

# ComfyUI image generation server (used in the dataset creation step).
COMFYUI_SERVER_ADDRESS=
COMFYUI_USERNAME=
COMFYUI_PASSWORD=
